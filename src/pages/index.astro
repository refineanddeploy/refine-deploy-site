---
import BaseLayout from '@layouts/BaseLayout.astro';
import InteractivePhone from '@components/react/InteractivePhone';
import AnimatedAboutButton from '@components/react/AnimatedAboutButton';
import RotatingShowcase from '@components/react/RotatingShowcase';

// Rotating hero images sourced from the portfolio
const heroImages = [
  { src: "/portfolio/Mantle.jpg", title: "Mantle", category: "SaaS / Automation" },
  { src: "/portfolio/Clicks.jpg", title: "Clicks", category: "AI Recruiting" },
  { src: "/portfolio/Fixpoint.jpg", title: "Fixpoint", category: "AI / Staffing" },
  { src: "/portfolio/HomePage.jpg", title: "HomePage", category: "E-commerce" },
  { src: "/portfolio/In-lease.jpg", title: "In-Lease", category: "Real Estate" },
  { src: "/portfolio/PerspekyivRaum.jpg", title: "PerspektivRaum", category: "Coaching" },
  { src: "/portfolio/UKSups.jpg", title: "UKS", category: "Product / Energy" },
];

// Interactive showcase projects - mix of live sites and design concepts
const showcaseProjects = [
  // Live Sites (show in phone)
  {
    title: "Sushibar Kilala",
    category: "Restaurant",
    url: "https://sushibarkilala.refineanddeploy.workers.dev/",
    description: "Authentic sushi bar — menu, hours, and reservations",
    type: "live"
  },
  {
    title: "Ehab Guitarrista",
    category: "Music & Arts",
    url: "https://ehabguitarrista.github.io/",
    description: "Professional musician portfolio",
    type: "live"
  },
  // Design Concepts (show in desktop)
  {
    title: "Clicks",
    category: "SaaS / Recruiting",
    image: "/portfolio/Clicks.jpg",
    description: "AI-powered recruiting platform",
    type: "design"
  },
  {
    title: "Fixpoint",
    category: "AI / Staffing",
    image: "/portfolio/Fixpoint.jpg",
    description: "Vetted experts for AI training",
    type: "design"
  },
  {
    title: "HomePage",
    category: "E-commerce",
    image: "/portfolio/HomePage.jpg",
    description: "Calm furniture for mindful living",
    type: "design"
  },
  {
    title: "In-Lease",
    category: "Real Estate",
    image: "/portfolio/In-lease.jpg",
    description: "Flexible corporate housing",
    type: "design"
  },
  {
    title: "Mantle",
    category: "SaaS / Automation",
    image: "/portfolio/Mantle.jpg",
    description: "Kill the busywork, keep momentum",
    type: "design"
  },
  {
    title: "PerspektivRaum",
    category: "Coaching",
    image: "/portfolio/PerspekyivRaum.jpg",
    description: "Clarity creates direction",
    type: "design"
  },
  {
    title: "UKS",
    category: "Product / Energy",
    image: "/portfolio/UKSups.jpg",
    description: "Fuel your breakthrough",
    type: "design"
  }
];

const services = [
  {
    title: "UX/UI Design",
    description: "Intuitive, user-centered interfaces that solve problems, boost engagement, and drive your business goals.",
    icon: "design"
  },
  {
    title: "Web & App Dev",
    description: "Fast, secure, and scalable digital products powered by modern frameworks and high-quality code.",
    icon: "dev"
  }
];
---

<BaseLayout title="Home">
  <!-- Hero Section - Clean Apple-style -->
  <section class="relative min-h-[100svh] flex items-center overflow-x-clip overflow-y-visible">
    <!-- Subtle gradient background -->
    <div class="absolute inset-0 bg-secondary"></div>

    <!-- Static gradient orbs - hidden on mobile for performance -->
    <div class="absolute inset-0 overflow-hidden hidden md:block pointer-events-none">
      <div class="absolute top-20 left-10 w-96 h-96 rounded-full filter blur-3xl opacity-20"
           style="background: rgb(var(--color-accent));"></div>
      <div class="absolute -bottom-20 left-1/3 w-96 h-96 rounded-full filter blur-3xl opacity-10"
           style="background: rgb(var(--color-accent));"></div>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Desktop only: Animated About Button - centered above content -->
      <div class="hidden lg:block relative h-20 -mt-64">
        <AnimatedAboutButton />
      </div>

      <!-- Mobile-first: Stack vertically, then grid on desktop -->
      <div class="flex flex-col lg:grid lg:grid-cols-2 gap-8 lg:gap-16 items-center">

        <!-- Text Content -->
        <div class="text-center lg:text-left order-2 lg:order-1 pt-8 lg:pt-0">
          <h1 class="text-primary mb-6 lg:mb-8">
            From scattered ideas to<br class="hidden sm:block" />
            <span class="text-accent">seamless</span> websites.
          </h1>

          <p class="text-secondary max-w-xl mx-auto lg:mx-0 mb-8 lg:mb-10">
            We create high-performing sites for all kinds of teams—new, small, or scaling.
            Whatever stage you're in, we build custom websites that work and grow with you.
          </p>

          <div class="flex flex-col sm:flex-row flex-wrap gap-4 justify-center lg:justify-start">
            <a href="/portfolio" class="btn-secondary" style="border: 1px solid #000;">
              View Our Work
            </a>
            <a href="/contact" class="btn-primary" style="border: 1px solid #000;">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              Get Started with a Free Consultation
            </a>
            <a href="/about" class="btn-primary" style="border: 1px solid #000;">
              More About Us
            </a>
          </div>
        </div>

        <!-- Hero Visual -->
        <div class="relative order-1 lg:order-2 w-full">
          <!-- Mobile only: Animated About Button -->
          <div class="lg:hidden">
            <AnimatedAboutButton />
          </div>

          <!-- Mobile: Preview cards with rotating real screenshots -->
          <div class="lg:hidden w-full max-w-md mx-auto pt-16 sm:pt-20">
            <div class="relative">
              <!-- Main card with rotating images.
                   p-3 (vs p-1) gives the prev/next buttons room to extend
                   past the image edge without leaving the card. -->
              <div class="card shadow-elevated p-3 transform -rotate-2">
                <div class="aspect-[4/3] bg-tertiary rounded-xl relative" style="overflow: visible;">
                  <div class="absolute top-0 left-0 right-0 z-10 p-2 flex gap-1 bg-gradient-to-b from-black/30 to-transparent rounded-t-xl">
                    <div class="w-2 h-2 rounded-full bg-red-400/80"></div>
                    <div class="w-2 h-2 rounded-full bg-yellow-400/80"></div>
                    <div class="w-2 h-2 rounded-full bg-green-400/80"></div>
                  </div>
                  <RotatingShowcase images={heroImages} interval={3500} client:load />
                </div>
              </div>
              <!-- Secondary floating card with offset rotation -->
              <div class="absolute -bottom-4 -left-4 w-24 card shadow-elevated p-1 transform rotate-6 overflow-hidden">
                <div class="aspect-[9/16] rounded-lg overflow-hidden">
                  <RotatingShowcase
                    images={[heroImages[2], heroImages[5], heroImages[0], heroImages[3]]}
                    interval={4200}
                    showCaption={false}
                    showControls={false}
                    client:visible
                  />
                </div>
              </div>
            </div>
          </div>

          <!-- Desktop: Single browser frame with rotating real screenshots + accent card for depth -->
          <div class="hidden lg:block relative w-full max-w-xl ml-auto h-[440px] mt-8">
            <!-- Decorative back card for depth -->
            <div
              class="absolute card shadow-elevated overflow-hidden transform rotate-3"
              style="top: 36px; right: -24px; width: 72%; height: 220px;"
            >
              <div class="p-2 border-b border-subtle">
                <div class="flex gap-1.5">
                  <div class="w-2 h-2 rounded-full bg-red-400/70"></div>
                  <div class="w-2 h-2 rounded-full bg-yellow-400/70"></div>
                  <div class="w-2 h-2 rounded-full bg-green-400/70"></div>
                </div>
              </div>
              <div class="h-[calc(100%-1.75rem)] overflow-hidden">
                <RotatingShowcase
                  images={[heroImages[3], heroImages[6], heroImages[1], heroImages[4]]}
                  interval={4200}
                  showCaption={false}
                  showControls={false}
                  client:visible
                />
              </div>
            </div>

            <!-- Main browser frame.
                 No overflow-hidden so the showcase prev/next buttons can
                 extend past the card edges. Rounded silhouette is
                 preserved by rounding the chrome (top) and image area
                 (bottom) individually. -->
            <div class="absolute top-0 left-0 right-12 card shadow-elevated transform -rotate-1 hover:rotate-0 transition-transform duration-500" style="overflow: visible;">
              <!-- Browser chrome -->
              <div class="px-4 py-3 border-b border-subtle flex items-center gap-3" style="border-top-left-radius: 1.5rem; border-top-right-radius: 1.5rem;">
                <div class="flex gap-1.5">
                  <div class="w-3 h-3 rounded-full bg-red-400"></div>
                  <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                  <div class="w-3 h-3 rounded-full bg-green-400"></div>
                </div>
                <div class="flex-1 h-6 rounded-md bg-tertiary"></div>
              </div>
              <!-- Image area -->
              <div class="relative h-[300px]" style="overflow: visible; border-bottom-left-radius: 1.5rem; border-bottom-right-radius: 1.5rem;">
                <RotatingShowcase images={heroImages} interval={3500} client:load />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 hidden md:block">
      <div class="w-6 h-10 rounded-full border-2 border-theme flex justify-center pt-2">
        <div class="w-1 h-2 bg-tertiary rounded-full animate-bounce"></div>
      </div>
    </div>
  </section>

  <!-- Interactive Phone Showcase Section -->
  <section class="section-padding bg-primary overflow-hidden">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10 lg:mb-12">
        <h2 class="text-primary" style="font-weight: 500; letter-spacing: -0.02em;">Interactive Phone</h2>
        <div class="w-12 h-0.5 bg-accent mx-auto mt-4 rounded-full"></div>
      </div>
      <InteractivePhone projects={showcaseProjects} client:visible />
    </div>
  </section>


  <!-- Services Section -->
  <section class="section-padding bg-primary">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-primary mb-4">Our Services</h2>
      <div class="w-16 sm:w-20 h-1 bg-accent mb-10 lg:mb-16 rounded-full"></div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 max-w-5xl">
        {services.map((service) => (
          <div class="card card-hover p-6 sm:p-8">
            <!-- Icon -->
            <div class="w-14 h-14 sm:w-16 sm:h-16 mb-5 sm:mb-6 rounded-2xl bg-accent/10 flex items-center justify-center">
              {service.icon === 'design' ? (
                <svg class="w-7 h-7 sm:w-8 sm:h-8 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42" />
                </svg>
              ) : (
                <svg class="w-7 h-7 sm:w-8 sm:h-8 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
                </svg>
              )}
            </div>

            <h3 class="text-primary mb-3 sm:mb-4">{service.title}</h3>
            <p class="text-secondary">{service.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section-padding bg-accent text-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-white mb-4 sm:mb-6">Ready to bring your ideas to life?</h2>
      <p class="text-lg sm:text-xl mb-8 sm:mb-10 max-w-2xl mx-auto opacity-90">
        Let's build something amazing together. Start your project today.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/contact"
          class="px-6 sm:px-8 py-3 sm:py-4 bg-white text-accent rounded-full
                 hover:bg-opacity-90 transition-all font-medium press-effect"
        >
          Get Started Today
        </a>
        <a
          href="/portfolio"
          class="px-6 sm:px-8 py-3 sm:py-4 bg-transparent text-white rounded-full
                 border-2 border-white/50 hover:bg-white/10 transition-all font-medium"
        >
          View Our Work
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
