---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="About">
  <!-- Hero Section -->
  <section class="section-padding bg-secondary">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-primary mb-6">
          About <span class="text-accent">Refine & Deploy</span>
        </h1>
        <p class="text-secondary text-lg sm:text-xl max-w-2xl mx-auto">
          We're a small, independent web studio that designs and builds modern websites for founders, growing teams, and established brands. Hands-on, opinionated, and obsessed with the details others overlook.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="section-padding bg-primary">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">

        <!-- Mission -->
        <div class="mb-12 lg:mb-16">
          <h2 class="text-primary mb-4">Our Mission</h2>
          <div class="w-12 h-1 bg-accent mb-6 rounded-full"></div>
          <p class="text-secondary">
            To make great web design accessible to teams of every size. We believe a beautiful, fast website shouldn't be a luxury reserved for funded startups—every business deserves a digital presence that earns trust on the first scroll and converts on the second. We pair clean design with engineering rigor so your site does both.
          </p>
        </div>

        <!-- Process -->
        <div class="mb-12 lg:mb-16">
          <h2 class="text-primary mb-4">Our Process</h2>
          <div class="w-12 h-1 bg-accent mb-6 rounded-full"></div>
          <p class="text-secondary">
            Every project starts with a real conversation, not a templated questionnaire. We learn your goals, your audience, and the constraints you're working inside, then move through design, development, and launch in tight feedback loops. You always see where the project stands, and you always know what's coming next.
          </p>
        </div>

        <!-- Why Choose Us -->
        <div class="mb-12 lg:mb-16">
          <h2 class="text-primary mb-4">Why Choose Us</h2>
          <div class="w-12 h-1 bg-accent mb-6 rounded-full"></div>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-accent/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span class="text-secondary"><strong class="text-primary">Direct communication.</strong> You work with the people building your site—no account managers, no handoffs lost in translation, no waiting weeks for a reply.</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-accent/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span class="text-secondary"><strong class="text-primary">Performance built in.</strong> Every site we ship is optimized for speed, accessibility, and SEO from day one—not patched on later when traffic exposes the cracks.</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-accent/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span class="text-secondary"><strong class="text-primary">Fair, transparent pricing.</strong> Clear quotes, fixed scopes, and no surprise invoices. We tell you what something costs before we start, and we stick to it.</span>
            </li>
          </ul>
        </div>

        <!-- CTA Card -->
        <div class="card p-6 sm:p-8 bg-accent/5 border-accent/20">
          <h3 class="text-primary mb-3">Ready to start your project?</h3>
          <p class="text-secondary mb-6">Whether you're starting from scratch or refining something that already exists, we'd love to hear what you have in mind. Send us a quick note and we'll come back with honest, useful next steps.</p>
          <a href="/contact" class="btn-primary">
            Get in Touch
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
