---
import BaseLayout from '@layouts/BaseLayout.astro';
import InteractivePhone from '@components/react/InteractivePhone';

// Combined showcase projects - live sites and design concepts
const showcaseProjects = [
  // Live Sites (show in phone)
  {
    title: "Ehab Guitarrista",
    category: "Music & Arts",
    url: "https://ehabguitarrista.github.io/",
    description: "Professional musician portfolio",
    type: "live"
  },
  // Design Concepts (show in desktop)
  {
    title: "Clicks",
    category: "SaaS / Recruiting",
    image: "/portfolio/Clicks.jpg",
    description: "AI-powered recruiting platform",
    type: "design"
  },
  {
    title: "Fixpoint",
    category: "AI / Staffing",
    image: "/portfolio/Fixpoint.jpg",
    description: "Vetted experts for AI training",
    type: "design"
  },
  {
    title: "HomePage",
    category: "E-commerce",
    image: "/portfolio/HomePage.jpg",
    description: "Calm furniture for mindful living",
    type: "design"
  },
  {
    title: "In-Lease",
    category: "Real Estate",
    image: "/portfolio/In-lease.jpg",
    description: "Flexible corporate housing",
    type: "design"
  },
  {
    title: "Mantle",
    category: "SaaS / Automation",
    image: "/portfolio/Mantle.jpg",
    description: "Kill the busywork, keep momentum",
    type: "design"
  },
  {
    title: "PerspektivRaum",
    category: "Coaching",
    image: "/portfolio/PerspekyivRaum.jpg",
    description: "Clarity creates direction",
    type: "design"
  },
  {
    title: "UKS",
    category: "Product / Energy",
    image: "/portfolio/UKSups.jpg",
    description: "Fuel your breakthrough",
    type: "design"
  }
];
---

<BaseLayout title="Portfolio">
  <!-- Hero Section -->
  <section class="section-padding bg-secondary">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-primary mb-6">Our Portfolio</h1>
        <p class="text-secondary text-lg sm:text-xl max-w-2xl mx-auto">
          From bold SaaS platforms to elegant e-commerce experiences. Explore live websites and design concepts across industries.
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive Showcase -->
  <section class="section-padding bg-primary overflow-hidden">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10 lg:mb-12">
        <h2 class="text-primary" style="font-weight: 500; letter-spacing: -0.02em;">Interactive Phone</h2>
        <div class="w-12 h-0.5 bg-accent mx-auto mt-4 rounded-full"></div>
      </div>
      <InteractivePhone projects={showcaseProjects} client:visible />
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section-padding bg-accent text-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-white mb-4 sm:mb-6">Like What You See?</h2>
      <p class="text-lg sm:text-xl mb-8 sm:mb-10 max-w-2xl mx-auto opacity-90">
        Let's create something beautiful together. Your brand deserves a website that stands out.
      </p>
      <a
        href="/contact"
        class="px-6 sm:px-8 py-3 sm:py-4 bg-white text-accent rounded-full
               hover:bg-opacity-90 transition-all font-medium press-effect inline-block"
      >
        Start Your Project
      </a>
    </div>
  </section>
</BaseLayout>
